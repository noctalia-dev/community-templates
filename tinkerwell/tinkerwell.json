{
  "base": "{{ mode | replace: "dark", "vs-dark" | replace: "light", "vs" }}",
  "inherit": true,
  "rules": [
    { "token": "", "foreground": "{{colors.on_surface.default.hex_stripped}}" },
    { "token": "comment", "foreground": "{{colors.outline.default.hex_stripped}}", "fontStyle": "italic" },
    { "token": "comment.php", "foreground": "{{colors.outline.default.hex_stripped}}", "fontStyle": "italic" },
    { "token": "keyword", "foreground": "{{colors.primary.default.hex_stripped}}" },
    { "token": "keyword.php", "foreground": "{{colors.primary.default.hex_stripped}}" },
    { "token": "keyword.operator", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" },
    { "token": "string", "foreground": "{{colors.terminal_normal_green.default.hex_stripped}}" },
    { "token": "string.php", "foreground": "{{colors.terminal_normal_green.default.hex_stripped}}" },
    { "token": "regexp", "foreground": "{{colors.terminal_normal_cyan.default.hex_stripped}}" },
    { "token": "number", "foreground": "{{colors.terminal_normal_yellow.default.hex_stripped}}" },
    { "token": "number.php", "foreground": "{{colors.terminal_normal_yellow.default.hex_stripped}}" },
    { "token": "constant.numeric", "foreground": "{{colors.terminal_normal_yellow.default.hex_stripped}}" },
    { "token": "constant.php", "foreground": "{{colors.terminal_normal_magenta.default.hex_stripped}}" },
    { "token": "variable", "foreground": "{{colors.on_surface.default.hex_stripped}}" },
    { "token": "variable.php", "foreground": "{{colors.on_surface.default.hex_stripped}}" },
    { "token": "variable.dollar.php", "foreground": "{{colors.primary.default.hex_stripped}}" },
    { "token": "variable.name.php", "foreground": "{{colors.on_surface.default.hex_stripped}}" },
    { "token": "variable.predefined.php", "foreground": "{{colors.error.default.hex_stripped}}" },
    { "token": "identifier.php", "foreground": "{{colors.on_surface.default.hex_stripped}}" },
    { "token": "class.php", "foreground": "{{colors.tertiary.default.hex_stripped}}" },
    { "token": "function.php", "foreground": "{{colors.terminal_normal_blue.default.hex_stripped}}" },
    { "token": "method.static.php", "foreground": "{{colors.terminal_normal_blue.default.hex_stripped}}" },
    { "token": "method.instance.php", "foreground": "{{colors.terminal_normal_blue.default.hex_stripped}}" },
    { "token": "property.static.php", "foreground": "{{colors.secondary.default.hex_stripped}}" },
    { "token": "property.instance.php", "foreground": "{{colors.secondary.default.hex_stripped}}" },
    { "token": "operator.php", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" },
    { "token": "delimiter", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" },
    { "token": "delimiter.bracket.php", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" },
    { "token": "delimiter.array.php", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" },
    { "token": "delimiter.parenthesis.php", "foreground": "{{colors.on_surface_variant.default.hex_stripped}}" }
  ],
  "colors": {
    "editor.background": "{{colors.surface.default.hex}}",
    "editor.foreground": "{{colors.on_surface.default.hex}}",
    "editor.selectionBackground": "{{colors.primary_container.default.hex}}",
    "editor.inactiveSelectionBackground": "{{colors.surface_container_highest.default.hex}}",
    "editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}",
    "editor.findMatchBackground": "{{colors.tertiary_container.default.hex}}",
    "editor.findMatchHighlightBackground": "{{colors.tertiary.default.hex}}40",
    "editor.wordHighlightBackground": "{{colors.surface_container_highest.default.hex}}",
    "editorCursor.foreground": "{{colors.primary.default.hex}}",
    "editorWhitespace.foreground": "{{colors.outline_variant.default.hex}}",
    "editorIndentGuide.background": "{{colors.outline_variant.default.hex}}",
    "editorIndentGuide.activeBackground": "{{colors.outline.default.hex}}",
    "editorLineNumber.foreground": "{{colors.outline.default.hex}}",
    "editorLineNumber.activeForeground": "{{colors.on_surface.default.hex}}",
    "editorBracketMatch.background": "{{colors.surface_container_highest.default.hex}}",
    "editorBracketMatch.border": "{{colors.outline.default.hex}}",
    "editorError.foreground": "{{colors.error.default.hex}}",
    "editorWarning.foreground": "{{colors.tertiary.default.hex}}",
    "editorWidget.background": "{{colors.surface_container.default.hex}}",
    "editorWidget.border": "{{colors.outline_variant.default.hex}}",
    "editorHoverWidget.background": "{{colors.surface_container.default.hex}}",
    "editorHoverWidget.border": "{{colors.outline_variant.default.hex}}",
    "editorSuggestWidget.background": "{{colors.surface_container.default.hex}}",
    "editorSuggestWidget.border": "{{colors.outline_variant.default.hex}}",
    "editorSuggestWidget.foreground": "{{colors.on_surface.default.hex}}",
    "editorSuggestWidget.highlightForeground": "{{colors.primary.default.hex}}",
    "editorSuggestWidget.selectedBackground": "{{colors.surface_container_highest.default.hex}}",
    "scrollbarSlider.background": "{{colors.on_surface_variant.default.hex}}33",
    "scrollbarSlider.hoverBackground": "{{colors.on_surface_variant.default.hex}}55",
    "scrollbarSlider.activeBackground": "{{colors.on_surface_variant.default.hex}}77"
  },
  "custom": {
    "primary.background": "{{colors.primary.default.hex}}",
    "primary.hoverBackground": "{{colors.primary.default.hex | lighten 6}}",
    "primary.activeBackground": "{{colors.primary.default.hex | darken 6}}",
    "primary.textColor": "{{colors.on_primary.default.hex}}",
    "secondary.background": "{{colors.surface_container_low.default.hex}}",
    "secondary.border": "{{colors.primary.default.hex}}",
    "secondary.hoverBorder": "{{colors.primary.default.hex | lighten 6}}",
    "secondary.activeBorder": "{{colors.primary.default.hex | darken 6}}",
    "secondary.textColor": "{{colors.on_surface.default.hex}}",
    "default.background": "{{colors.surface.default.hex}}",
    "default.border": "{{colors.outline_variant.default.hex}}",
    "default.hoverBorder": "{{colors.outline.default.hex}}",
    "default.activeBorder": "{{colors.primary.default.hex}}",
    "default.textColor": "{{colors.on_surface_variant.default.hex}}",
    "link.color": "{{colors.primary.default.hex}}",
    "magicComments.text": "{{colors.tertiary.default.hex}}",
    "theme.isLight": {{ mode | replace: "dark", "false" | replace: "light", "true" }}
  }
}
