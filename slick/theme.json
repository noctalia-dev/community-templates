  "css": [
    "body::before{content:'';position:fixed;inset:0;z-index:0;background:{{colors.surface_container_lowest.default.hex}};pointer-events:none;}",
    ".p-theme_background{background:{{colors.surface_container_lowest.default.hex}} !important;}",
    ".p-theme_background:after{backdrop-filter:none !important;background:{{colors.surface_container_lowest.default.hex}} !important;}",
    ".p-view_contents--sidebar{background:{{colors.surface_container_low.default.hex}} !important;}",
    ".c-message_list__unread_divider--unread_threads .c-message_list__unread_divider__label,.p-threads_flexpane__unread_divider__label,.p-threads_flexpane__read_divider__label{color:{{colors.error.default.hex}} !important;}",
    ".c-tabs__tab_menu--vertical .c-tabs__tab.c-tabs__tab--active,.c-tabs__tab_menu--vertical .c-tabs__tab:active{background-color:{{colors.primary.default.hex}} !important;color:{{colors.on_primary.default.hex}} !important;}",
    "input[type=checkbox],input[type=radio],progress{accent-color:{{colors.primary.default.hex}};}",
    "::selection{background:{{colors.primary.default.hex}}4d;}",
    ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:{{colors.primary.default.hex}} !important;color:{{colors.on_primary.default.hex}} !important;}",
    ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:{{colors.primary.default.hex}}cc !important;}",
    "[data-qa=huddle_toolbar__leave_button]{background-color:{{colors.error.default.hex}} !important;color:{{colors.on_error.default.hex}} !important;}",
    "[data-qa=huddle_toolbar__leave_button]:hover{background-color:{{colors.error.default.hex}}cc !important;}",
    ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-wysiwyg_container--theme_light code,.c-pillow_file__post__content code{color:{{colors.tertiary.default.hex}} !important;}",
    ".c-message--pinned .c-message__label__icon,.c-message_kit__labels--pinned .c-message_kit__labels__icon,.p-drafts_page__draft_badge{color:{{colors.tertiary.default.hex}} !important;}",
    ".c-reaction--reacted,.c-reaction--reacted:hover{background-color:{{colors.primary.default.hex}}2e !important;box-shadow:0 0 0 1px {{colors.primary.default.hex}} !important;}",
    ".c-reaction--reacted .c-reaction__count{color:{{colors.primary.default.hex}} !important;}",
    ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark,.c-wysiwyg_container--theme_light{background-color:{{colors.surface_container_low.default.hex}} !important;border:1px solid {{colors.surface_container_highest.default.hex}} !important;}",
    ".c-wysiwyg_container__formatting{background:{{colors.surface_container_low.default.hex}} !important;}",
    ".p-context_bar_v2,[data-qa=context_bar]{background:{{colors.surface_container_low.default.hex}} !important;border:1px solid {{colors.surface_container_highest.default.hex}} !important;}",
    ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:{{colors.on_surface_variant.default.hex}} !important;}",
    "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background-color:{{colors.surface_container_low.default.hex}} !important;border:1px solid {{colors.surface_container_high.default.hex}} !important;}",
    ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:{{colors.surface_container.default.hex}} !important;}",
    ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:{{colors.surface_container.default.hex}} !important;}",
    ".p-about_modal__contents{background:{{colors.surface_container_low.default.hex}} !important;border:1px solid {{colors.surface_container_high.default.hex}} !important;}",
    ".p-member_profile_hover_card__container_deleted{background:{{colors.surface_container_low.default.hex}} !important;border:1px solid {{colors.surface_container_high.default.hex}} !important;}",
    ".p-member_profile_hover_card__banner_deactivated_dark,.p-member_profile_hover_card__banner_deactivated_light,.p-member_profile_restriction_deleted,.p-member_profile_hover_card__container_deleted .c-avatar{background:{{colors.surface_container_high.default.hex}} !important;}",
    ".p-view_header:has(~ * > .p-outbox_page__tab-menu),.p-outbox_page__tab-menu,.p-drafts_page,.p-sent_page{background:{{colors.surface.default.hex}} !important;}",
    ".p-view_header:has(~ * > .p-threads_view),.p-threads_view{background:{{colors.surface.default.hex}} !important;}",
    ".c-virtual_list__item:has(> [data-qa=reply_container]),.c-virtual_list__item > [data-qa=reply_container],.c-virtual_list__item > [data-qa=reply_container] > .p-threads_footer__input{background:{{colors.surface.default.hex}} !important;}"
  ]
}
